{
  "name": "utsav-planner",
  "version": "1.0.0",
  "description": "GenAI celebration planner: budgets, timelines, vendor checklists and personalised ideas for weddings, birthdays and community events. Cloudflare Workers + Workers AI.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,css,html,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-istanbul": "^5.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260911.1": true
  }
}
