{
  "name": "utsav-planner",
  "version": "1.0.0",
  "description": "GenAI celebration planner: budgets, timelines, vendor checklists and personalised ideas for weddings, birthdays and community events. Cloudflare Workers + Workers AI.",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretypecheck": "wrangler types && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && tsc --noEmit -p tsconfig.app.json",
    "prelint": "wrangler types && npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,css,html,json,md}\"",
    "pretest": "wrangler types && npm run build",
    "test": "vitest run",
    "test:watch": "wrangler types && npm run build && vitest",
    "precoverage": "wrangler types && npm run build",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-istanbul": "^4.1.12",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  }
}
